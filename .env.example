# TrendRadar Local — environment configuration
# Copy this file to backend/.env and fill in optional values.
# Everything works without any keys; keys only improve metadata quality.

# SQLite database location (relative to backend/prisma/)
DATABASE_URL="file:./dev.db"

# Backend port (bound to 127.0.0.1 only — never exposed publicly)
PORT=3001

# OPTIONAL: YouTube Data API v3 key.
# The app works without it (uses the free public oEmbed endpoint),
# but a key unlocks view/like/comment counts and search.
# Get one free at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# OPTIONAL: Ollama for local AI idea generation (can also be set in Settings UI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
